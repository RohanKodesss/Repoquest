# GitHub API token
# Get one at: https://github.com/settings/tokens
# Needs: public_repo scope (read-only)
GITHUB_TOKEN=your_github_token_here

# Google Gemini API key
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name.
# Model names change often. Copy the current Flash model name from:
# https://aistudio.google.com
# Example value (verify before use): gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# Flask
# Set to 1 to enable debug mode locally. Never set on a public link.
FLASK_DEBUG=1
